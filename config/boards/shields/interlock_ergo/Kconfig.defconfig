# Configuration defaults for Interlock Ergo shields

if SHIELD_INTERLOCK_ERGO_LEFT || SHIELD_INTERLOCK_ERGO_RIGHT

config ZMK_SPLIT
    default y

config ZMK_KEYBOARD_NAME
    default "Interlock Ergo"

endif

if SHIELD_INTERLOCK_ERGO_DONGLE

config ZMK_SPLIT
    default y

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

config ZMK_KEYBOARD_NAME
    # Zephyr asserts the BLE device name is <= BT_DEVICE_NAME_MAX (16 incl. NUL).
    # "Interlock Ergo Dongle" is 21 and fails the build; "Interlock Ergo" is 14.
    default "Interlock Ergo"

config ZMK_USB
    default y

config ZMK_BLE
    default y

endif
