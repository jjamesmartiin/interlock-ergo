#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <14>;
        rows = <5>;
        /*
         * Matrix Layout:
         * Left half: cols 0..5 (29 keys)
         *   - Col 0: Esc, Tab, Caps, Shift, Ctrl
         *   - Col 1..5: the letter block (1..5, Q..T, A..G, Z..B, Space)
         * Right half: cols 6..13 (39 keys)
         *   - Col 6: 6, Y, H, N, Space_R (STRICTLY ON RIGHT HALF)
         *   - Col 7..13: 7..0, symbols, enter, inverted-T arrow cluster
         *
         * 14 columns = DZ60 split down the middle (6 left + 8 right).
         * Right half inverted-T arrow cluster:
         *   - Up at RC(3,11) [x=6.25u] sits directly above Down at RC(4,12) [x=6.25u]
         *   - Left at RC(4,11) [x=5.25u] sits directly under / at RC(3,10) [x=5.25u]
         *   - Right at RC(4,13) [x=7.25u] sits directly under RShift at RC(3,12) [x=7.25u]
         */
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)     RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)     RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)     RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)     RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11) RC(3,12) RC(3,13)
            RC(4,0) RC(4,1) RC(4,2) RC(4,3)         RC(4,5)     RC(4,6) RC(4,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11) RC(4,12) RC(4,13)
        >;
    };
};
